# PORT=8003
# AGENT_ID=ba-01
# AGENT_ROLE=BA
# AGENT_API_KEY=ba-secure-token-32bytes-secret
# MAX_UPLOAD_MB=50

# --- SA Agent (agents/sa/.env) ---
# HOST=0.0.0.0
# PORT=8004
# AGENT_ID=sa-01
# AGENT_ROLE=SA
# AGENT_API_KEY=sa-secure-token-32bytes-secret
# MAX_UPLOAD_MB=50

# --- Lệnh mở Firewall (PowerShell Admin) ---
# New-NetFirewallRule -DisplayName "AI-Team (Machine 2)" -Direction Inbound -LocalPort 8003,8004 -Protocol TCP -Action Allow
