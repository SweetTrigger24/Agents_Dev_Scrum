# ==============================================================================
# MÁY 1 (IP mẫu: 192.168.1.101) - Đảm nhiệm PM Agent và DevOps Agent
# ==============================================================================

# --- PM Agent (agents/pm/.env) ---
# HOST=0.0.0.0
# PORT=8001
# AGENT_ID=pm-01
# AGENT_ROLE=PM
# AGENT_API_KEY=pm-secure-token-32bytes-secret
# MAX_UPLOAD_MB=50
# PM_AUTO_APPROVE=false
# PM_ALLOW_REAL_DEPLOY=false
# MAX_FIX_LOOPS=3
# MAX_TASKS_PER_PROJECT=60
# PROJECT_TIMEOUT_MINUTES=240

# --- DevOps Agent (agents/devops/.env) ---
# HOST=0.0.0.0
# PORT=8002
# AGENT_ID=devops-01
# AGENT_ROLE=DEVOPS
# AGENT_API_KEY=devops-secure-token-32bytes-secret
# MAX_UPLOAD_MB=50

# --- Lệnh mở Firewall (PowerShell Admin) ---
# New-NetFirewallRule -DisplayName "AI-Team (Machine 1)" -Direction Inbound -LocalPort 8001,8002 -Protocol TCP -Action Allow
