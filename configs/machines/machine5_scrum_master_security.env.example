# ==============================================================================
# MÁY 5 (IP mẫu: 192.168.1.105) - Đảm nhiệm SCRUM_MASTER Agent và SECURITY Agent
# ==============================================================================

# --- SCRUM_MASTER Agent (agents/scrum_master/.env) ---
# HOST=0.0.0.0
# PORT=8009
# AGENT_ID=scrum_master-01
# AGENT_ROLE=SCRUM_MASTER
# AGENT_API_KEY=scrum_master-secure-token-32bytes-secret
# MAX_UPLOAD_MB=50

# --- SECURITY Agent (agents/security/.env) ---
# HOST=0.0.0.0
# PORT=8010
# AGENT_ID=security-01
# AGENT_ROLE=SECURITY
# AGENT_API_KEY=security-secure-token-32bytes-secret
# MAX_UPLOAD_MB=50

# --- Lệnh mở Firewall (PowerShell Admin) ---
# New-NetFirewallRule -DisplayName "AI-Team (Machine 5)" -Direction Inbound -LocalPort 8009,8010 -Protocol TCP -Action Allow
