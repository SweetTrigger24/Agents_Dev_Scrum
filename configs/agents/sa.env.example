# configs/agents/sa.env.example
# Cấu hình chuẩn cho System Architect Agent cho máy 2
AGENT_ID=sa-01
AGENT_ROLE=SA
HOST=0.0.0.0
PORT=8004
CONTRACT_MIN_VERSION=1.0.0
AGENT_API_KEY=lan_secret_sa_token_secure
MAX_UPLOAD_MB=50

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

ARTIFACT_DIR=./artifacts
WORKSPACE_DIR=./workspace
ALLOWED_COMMANDS=
DRY_RUN=true
