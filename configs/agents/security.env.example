# configs/agents/security.env.example
# Cấu hình chuẩn cho Security Engineer Agent cho máy 5
AGENT_ID=security-01
AGENT_ROLE=SECURITY
HOST=0.0.0.0
PORT=8010
CONTRACT_MIN_VERSION=1.0.0
AGENT_API_KEY=lan_secret_security_token_secure
MAX_UPLOAD_MB=50

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

ARTIFACT_DIR=./artifacts
WORKSPACE_DIR=./workspace
ALLOWED_COMMANDS=
DRY_RUN=true
